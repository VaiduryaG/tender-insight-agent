# 数据库配置
DB_TYPE=postgresql  # postgresql 或 sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bidding_agent
DB_USER=postgres
DB_PASSWORD=your_password

# Neo4j配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# LLM API配置（选择一个）
# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 或 Qwen
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 向量模型配置
EMBEDDING_MODEL=text2vec-base-chinese  # 或其他模型
EMBEDDING_DEVICE=cpu  # 或 cuda

# 爬虫配置
CRAWLER_DELAY_MIN=2  # 最小延时（秒）
CRAWLER_DELAY_MAX=5  # 最大延时（秒）
CRAWLER_MAX_RETRIES=3  # 最大重试次数

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# MCP配置
MCP_SERVER_NAME=bidding-agent
MCP_SERVER_VERSION=1.0.0